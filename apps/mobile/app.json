{
  "expo": {
    "name": "Agent Pet",
    "slug": "agent-pet",
    "version": "0.1.0",
    "scheme": "agentpet",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.agentpet.companion",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "配对时通过蓝牙连接你的 Agent Pet 设备，把 Wi-Fi 设置安全地发给它。",
        "NSLocalNetworkUsageDescription": "连接你电脑上运行的 Agent Pet（同一个 Wi-Fi 或这部手机的热点里），读取任务和设备状态。"
      }
    },
    "android": {
      "package": "dev.agentpet.companion",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "扫描电脑和设备屏幕上的配对二维码。",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "./plugins/withProvisioning"
    ],
    "autolinking": { "nativeModulesDir": "./modules" }
  }
}
